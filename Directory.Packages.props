<Project>
  <!-- Central package management: every version pinned here. Add THIRD_PARTY_NOTICES.md entry with each new package. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- Notes and tasks storage (ADR 0023); brings SQLitePCLRaw 2.1.13 and native SQLite. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Test only (not redistributed)">
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (opted in via global.json "test.runner"); no VSTest packages. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
