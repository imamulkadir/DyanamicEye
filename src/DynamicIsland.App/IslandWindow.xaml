<Window x:Class="DynamicIsland.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="200" Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        AutomationProperties.Name="Dynamic Island">
    <!--
      ShowInTaskbar stays True so WPF does not create a hidden owner window; the taskbar button and Alt+Tab entry are
      removed with WS_EX_TOOLWINDOW instead (IslandWindowInterop.MakeToolWindow).
      Original artwork: plain rounded capsule, no third-party assets.
    -->
    <Border x:Name="Pill"
            CornerRadius="18"
            Background="#F2111214"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Focusable="True"
            KeyboardNavigation.IsTabStop="True"
            AutomationProperties.Name="Dynamic Island, collapsed">
        <Ellipse Width="8" Height="8"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#FF3DDC84"
                 AutomationProperties.Name="Status indicator" />
    </Border>
</Window>
