<UserControl x:Class="DynamicIsland.App.NotchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland.App"
             Width="236" Height="32">
    <!--
      The island's visuals: a classic display notch (IslandSurface) with the clock and the expanded panel.
      Separate from the window so it can be rendered offscreen for visual regression tests (ADR 0011).
      Original artwork drawn from simple geometry; no third-party assets.
    -->
    <UserControl.Resources>
        <!-- Minimal dark icon button: no default light chrome; visible focus ring for keyboard users. -->
        <Style x:Key="IslandIconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B3F2F3F5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FF3DDC84" />
                                <Setter TargetName="Chrome" Property="Background" Value="#1F3DDC84" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFF2F3F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <local:IslandSurface x:Name="Surface"
                         Fill="Black"
                         ShoulderRadius="6"
                         BottomRadius="16"
                         SnapsToDevicePixels="True"
                         Focusable="True"
                         FocusVisualStyle="{x:Null}"
                         AutomationProperties.Name="Dynamic Island"
                         AutomationProperties.HelpText="Press Enter to expand, Escape to collapse, Ctrl+P to pin.">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Clock row: the collapsed notch's height (scaled in ApplyVisualState). -->
                <RowDefinition x:Name="ClockRow" Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Clock (ADR 0016): replaces the earlier decorative sensor housing; always visible at the top of the notch. -->
            <TextBlock x:Name="ClockText"
                       Foreground="#FFF2F3F5"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="14,0"
                       IsHitTestVisible="False"
                       Typography.NumeralAlignment="Tabular"
                       AutomationProperties.Name="Time" />

            <!-- Expanded content placeholder: widgets arrive in P04. -->
            <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="18,4,18,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <ToggleButton x:Name="PinButton"
                                  DockPanel.Dock="Right"
                                  Width="28" Height="28"
                                  Style="{StaticResource IslandIconToggle}"
                                  Content="&#xE718;"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  FontSize="14"
                                  ToolTip="Keep the island open"
                                  AutomationProperties.Name="Pin island" />
                    <TextBlock Text="Dynamic Island"
                               Foreground="#FFF2F3F5" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Row="1"
                           Text="Widgets will appear here."
                           Foreground="#B3F2F3F5" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </local:IslandSurface>
</UserControl>
