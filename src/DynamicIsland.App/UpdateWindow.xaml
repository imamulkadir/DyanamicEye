<Window x:Class="DynamicIsland.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island update"
        AutomationProperties.AutomationId="Update.Window"
        Width="540" SizeToContent="Height" MinWidth="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- Release details and the separate Download and Install approvals (guide §7, P06-04, ADR 0033). -->
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Update.Heading" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="Update.Summary" />

        <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,14,0,4" />
        <ScrollViewer x:Name="NotesScroller" MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="True"
                      AutomationProperties.Name="Release notes" AutomationProperties.AutomationId="Update.Notes">
            <StackPanel x:Name="NotesPanel" />
        </ScrollViewer>
        <TextBlock Margin="0,8,0,0">
            <Hyperlink x:Name="ReleaseLink" Click="OnReleaseLink" AutomationProperties.AutomationId="Update.ReleaseLink">View this release on GitHub</Hyperlink>
        </TextBlock>

        <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100"
                         AutomationProperties.Name="Download progress" AutomationProperties.AutomationId="Update.Progress" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                       AutomationProperties.AutomationId="Update.ProgressText" />
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0"
                   AutomationProperties.AutomationId="Update.Status" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrimaryButton" Click="OnPrimary" AutomationProperties.AutomationId="Update.Primary" />
            <Button x:Name="SecondaryButton" Click="OnSecondary" IsCancel="True" AutomationProperties.AutomationId="Update.Secondary" />
        </StackPanel>
    </StackPanel>
</Window>
