<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Crash supervisor (D03, guide §4.5): starts DynamicIsland.exe from its own folder, waits, applies CrashPolicy.
    Lives exactly as long as the app; never a background service. WinExe so no console window appears at sign-in.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DynamicIsland.Launcher</AssemblyName>
    <ApplicationIcon>..\..\assets\DynamicIsland.ico</ApplicationIcon>
    <!-- Required by LibraryImport-generated P/Invoke stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Release layout (ADR 0030): published as one NativeAOT file, the stable root DynamicIsland.exe (~4 MB, no runtime
      to extract). Publishing needs the C++ build tools; normal builds and tests do not.
    -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.Core\DynamicIsland.Core.csproj" />
    <ProjectReference Include="..\DynamicIsland.Infrastructure\DynamicIsland.Infrastructure.csproj" />
  </ItemGroup>

</Project>
