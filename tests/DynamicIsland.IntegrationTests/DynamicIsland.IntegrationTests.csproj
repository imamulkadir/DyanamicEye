<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DynamicIsland.App\DynamicIsland.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF implicit usings omit System.IO. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Visual regression references: our own renderings (NotchVisualTests). -->
    <None Include="References\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\StaDispatcherThread.cs" Link="TestSupport\StaDispatcherThread.cs" />
  </ItemGroup>

</Project>
