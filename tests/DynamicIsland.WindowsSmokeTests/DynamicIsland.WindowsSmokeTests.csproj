<Project Sdk="Microsoft.NET.Sdk">

  <!-- Launches the real app on an interactive Windows desktop. Requires a desktop session (not Server Core/containers). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Required by LibraryImport-generated P/Invoke stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UI Automation client (System.Windows.Automation) drives the island like a screen reader would. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF implicit usings omit System.IO. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order + copy of the app and launcher outputs only; tests drive them as external processes. -->
    <ProjectReference Include="..\..\src\DynamicIsland.App\DynamicIsland.App.csproj" />
    <ProjectReference Include="..\..\src\DynamicIsland.Launcher\DynamicIsland.Launcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\StaDispatcherThread.cs" Link="TestSupport\StaDispatcherThread.cs" />
  </ItemGroup>

</Project>
